# The network family's read paths beyond netlink and its write paths (spec §9.1, §41.2, §43;
# ADR-0087, ADR-0088). The container has no network: `localhost` is answered from /etc/hosts
# through the system resolver, the port probe targets a listener the case starts itself, and a
# routing-table change is refused by the kernel for an unprivileged user — as one failed
# ActionResult row with the structured permission error, not as text and not as "not built".
case: dns resolution, port probes and a refused network mutation are structured answers
timeout: 120
run: |
  echo "== resolve dns =="
  ono -c 'resolve dns localhost --type A | select name type address | to json'
  ono -c 'resolve dns 127.0.0.1 | select type | to json'
  ono -c 'resolve dns definitely.invalid. | to json' 2>&1 | grep -o 'Ono-Sendai-E0[34]01' | head -1
  echo "checked"
exit: 0
stdout-contains: {"name":"localhost","type":"A","address":"127.0.0.1"}
stdout-contains: [{"type":"PTR"}]
stdout-contains: Ono-Sendai-E0
stdout-contains: checked
