# v0.6 §50 phase P2 — §29.1, §29.2 and §10.3: a remote change is a plan like any other, and its
# coverage matrix is per host.
#
# The link's local transport makes a second host of the same container: `link host l1
# --transport local` starts an agent the shell speaks the link protocol to, exactly as it would
# over ssh, and `enter link l1` sends every provider call there (ADR-0848). §29.2's worked matrix —
# twelve ZFS hosts, six Btrfs, two unprotected, composing to PARTIALLY PROTECTED — is the
# composition rule, proved at `crates/ono-change-protection/tests/remote.rs`; what the container
# proves is that a plan made through a link is about the linked host, says so in its matrix, and
# runs only where that host is.
case: coverage is per host, and a plan about a linked host runs only where that host is
timeout: 180
env: NO_COLOR=1
run: |
  prove() {
    local id="$1" what="$2" check="$3" out
    if out=$(eval "$check" 2>&1); then
      printf 'PROVED %s: %s\n' "$id" "$what"
    else
      printf 'FAILED %s: %s\n' "$id" "$what"
      printf '%s\n' "$out" | head -6 | sed 's/^/        /'
    fi
  }
  plan_id() { sed -n 's/^\[{"id":"\([0-9a-f]\{16\}\)".*/\1/p' "$1" | head -1; }

  mkdir -p "$HOME/etc"
  for n in 1 2; do printf 'target %s\n' "$n" > "$HOME/etc/target$n"; done
  printf 'source\n' > "$HOME/etc/source"

  echo '== §11.1 and §29.2: every asset names the host it lives on =='
  for n in 1 2; do
    ono -c "plan copy file $HOME/etc/source $HOME/etc/target$n --overwrite | to json" > /tmp/rp0.json 2>&1
    ono -c "apply $(plan_id /tmp/rp0.json)" > /dev/null 2>&1
  done
  ono -c 'get recovery | select host | to json' > /tmp/rp1.json 2>&1
  prove rp1a "both assets name a host, and it is the same one (§11.1, §29.2)" \
    "[ \"\$(grep -o '{\"host\":\"[^\"]\{1,\}\"}' /tmp/rp1.json | wc -l)\" -eq 2 ] && [ \"\$(grep -o '{\"host\":\"[^\"]*\"}' /tmp/rp1.json | sort -u | wc -l)\" -eq 1 ]"

  # A home of its own for the linked plans, so no later case finds a plan about a host it never
  # linked.
  HOME=$(mktemp -d)
  export HOME
  unset XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME
  mkdir -p "$HOME/etc"
  printf 'a\n' > "$HOME/etc/a"
  printf 'b\n' > "$HOME/etc/b"
  sleep 300 > /dev/null 2>&1 &
  SLEEPER=$!

  echo '== §7.1 and §29.1: a plan made through a link is about the linked host =='
  ono -c "link host l1 --transport local; enter link l1; plan kill process $SLEEPER | to json" > /tmp/rp2.json 2>&1
  prove rp2a "the target is frozen as the linked host's (§7.1, §29.1)" \
    'grep -q "\"host\":\"l1\"" /tmp/rp2.json'
  prove rp2b "and the protection matrix names the host it is about (§29.2)" \
    'grep -q "\"subject\":\"l1\"" /tmp/rp2.json'

  echo '== §29.1: a plan runs only where its host is =='
  ono -c "apply $(plan_id /tmp/rp2.json) --accept-risk --accept-irreversible --confirm" > /tmp/rp3.txt 2>&1
  prove rp3a "outside the link the plan about l1 is refused, naming the host, and nothing ran (§29.1, §2.3)" \
    "grep -q 'change.precondition_failed' /tmp/rp3.txt && grep -q 'l1' /tmp/rp3.txt && kill -0 $SLEEPER"
  ono -c "link host l1 --transport local; enter link l1; plan copy file $HOME/etc/a $HOME/etc/b --overwrite" > /tmp/rp4.txt 2>&1
  prove rp3b "a file inside the link is refused rather than resolved against this machine (ADR-0848)" \
    "grep -q 'change.action_not_plannable' /tmp/rp4.txt && [ \"\$(ono -c 'get plan | count | to json' 2>&1 | tr -d '[:space:]')\" = '[1]' ]"
  kill "$SLEEPER" 2>/dev/null || true

  echo '== §28.3: the bulk thresholds a per-host plan is measured against are configured =='
  prove rp4a "\`change.bulk.high_risk_targets\` defaults to fifty (§28.3, §53)" \
    "ono -c 'get config change.bulk.high_risk_targets | to json' 2>&1 | grep -q '^\[{\"key\":\"change.bulk.high_risk_targets\",\"value\":50,'"

  echo 'remote-protection-matrix: done'
exit: 0
stdout-contains: PROVED rp1a
stdout-contains: PROVED rp2a
stdout-contains: PROVED rp2b
stdout-contains: PROVED rp3a
stdout-contains: PROVED rp3b
stdout-contains: PROVED rp4a
stdout-contains: remote-protection-matrix: done
stdout-not-contains: FAILED
stdout-not-contains: SKIPPED
stdout-not-contains: panicked
