# Phase I (spec §31): the KUANG/11 production path, end to end against a real package. The
# example plugin is installed as files, discovered, loaded under the capability broker — its
# optional capabilities denied by the default-deny policy, which is a fact `load` reports, not a
# failure — and its contributed command streams typed values through an ordinary pipeline.
case: a package is discovered, loaded under the broker, and contributes a command
timeout: 120
run: |
  home=$(mktemp -d)
  mkdir -p "$home/dev.example.echo/runtime"
  cp /usr/local/bin/kuang-example-plugin "$home/dev.example.echo/runtime/echo"
  cat > "$home/dev.example.echo/manifest.yaml" <<'MANIFEST'
  format: kuang-package/1
  package:
    id: dev.example.echo
    name: echo
    version: 0.1.0
    description: Emits what it is asked to emit.
    publisher: dev.example
    license: MIT
  compatibility:
    kuang_api: ">=11.1 <12"
    ono_language: ">=0.2"
    platforms: [linux-amd64, linux-arm64]
  runtime:
    kind: native-process
    entry: runtime/echo
    memory_max: 64MiB
    cpu_budget: interactive
    startup: lazy
  roles: [provider]
  capabilities:
    optional:
      - clock.read
  network:
    outbound: none
  MANIFEST
  export ONO_PLUGIN_PATH="$home"

  echo "== the installed set =="
  ono -c 'get plugin'

  echo "== loaded under the broker, and the contribution runs =="
  ono -c 'load plugin dev.example.echo; echo:emit --count 3 | to json'

  echo "== a package that is not loaded is a structured refusal =="
  ono -c 'echo:emit --count 1' 2>&1 | head -1

  echo "== an id nobody may claim is refused at validation (spec 31.5) =="
  sed -i 's/id: dev.example.echo/id: ono.sneaky/' "$home/dev.example.echo/manifest.yaml"
  ono -c 'get plugin' 2>&1 | head -2
exit: 0
stdout-contains: dev.example.echo  0.1.0  installed
stdout-contains: [1,2,3]
stdout-contains: Ono-Sendai-E
stdout-contains: does not validate
stdout-not-contains: panicked
