# K11P §7.4, §9.3, §15, §16.2, §20.2, §28.3 (ADR-0602 §5, ADR-0604): the recommended access is
# read-only; a mutation before elevation is refused in the permission's words with the elevation
# named; enabling it is a deliberate decision — confirmed interactively, `--confirm`ed in a
# script — as one permission or as the `operate` profile; a deny stands ahead of any grant; and a
# grant made by hand shows as `custom` while an unmapped one stays a `legacy` row rather than
# disappearing. Gates F, K, L.
case: mutation stays an explicit decision, and the expert surface projects onto the human one
timeout: 180
run: |
  home=$(mktemp -d)
  export ONO_PLUGIN_PATH="$home/plugins"
  export ONO_PLUGIN_SOURCES="$home/sources"
  export ONO_SYSTEM_CONFIG_DIR="$home/system"
  export HOME="$home/home"
  export XDG_STATE_HOME="$home/state"
  export XDG_CONFIG_HOME="$home/config"
  export XDG_CACHE_HOME="$home/cache"
  export ONO_CONFIG_DIR="$home/config/ono"
  mkdir -p "$home/plugins" "$home/home" "$home/config/ono/kuang/catalogs"
  # A `kuang-package/2` package in the shape of the reference provider (K11P §8.2), over the
  # example runtime: observation recommended, relationships automatic, a login helper asked
  # just in time, mutation explicit.
  lay_out() {
    mkdir -p "$1/$2/runtime" "$1/$2/contributions"
    cp /usr/local/bin/kuang-example-plugin "$1/$2/runtime/echo"
    cat > "$1/$2/manifest.yaml" <<MANIFEST
  format: kuang-package/2
  package:
    id: $2
    name: $3
    version: $4
    description: Emits what it is asked to emit.
    publisher: dev.example
    license: MIT
  compatibility:
    kuang_api: ">=11.2 <12"
    ono_language: ">=0.2"
    platforms: [linux-amd64, linux-arm64]
  runtime:
    kind: native-process
    entry: runtime/echo
    memory_max: 64MiB
    cpu_budget: interactive
    startup: lazy
  roles: [provider]
  capabilities:
    optional:
      - network.connect
      - process.signal
      - filesystem.read: {paths: ["$5"]}
      - secret.use
      - clock.read
      - relation.write
      - process.exec
  network:
    outbound: none
  contributions:
    commands: [contributions/commands.yaml]
  permissions:
    profiles:
      minimal: {title: Minimal, permissions: [spatial-relations]}
      recommended: {title: Recommended, permissions: [cluster-access, kubeconfig-read, credential-use, spatial-relations]}
      operate: {title: Observe and change, permissions: [cluster-access, kubeconfig-read, credential-use, spatial-relations, cluster-mutation]}
    requests:
      - {id: cluster-access, kind: external-observe, title: Connect to clusters, phase: install, recommended: true, grants: [{capability: network.connect, scope: runtime-derived}]}
      - {id: kubeconfig-read, kind: filesystem-read, title: Read cluster configuration, phase: install, recommended: true, grants: [{capability: filesystem.read, scope: {paths: ["$5"]}}]}
      - {id: credential-use, kind: secret-use, title: Use credentials without exposing their values, phase: install, recommended: true, grants: [{capability: secret.use}]}
      - {id: spatial-relations, kind: local-contribution, title: Add relationships to Ono, phase: automatic, recommended: true, grants: [{capability: relation.write, scope: package-contributions}]}
      - {id: login-helper, kind: execute-helper, title: Run an external login helper when a context requires it, purpose: authenticate to the selected context, phase: jit, recommended: false, grants: [{capability: process.exec, scope: runtime-derived}]}
      - {id: cluster-mutation, kind: host-change, title: Change resources, phase: explicit, recommended: false, grants: [{capability: process.signal}]}
  MANIFEST
    cat > "$1/$2/contributions/commands.yaml" <<CONTRIB
  commands:
    - id: $2.command.emit
      verb: get
      target: echo-item
      summary: Emit a counted stream of integers.
      output: stream<int>
      argument_mode: expression
      capabilities: []
      examples:
        - get echo-item --count 3
    - id: $2.command.exec
      verb: get
      target: echo-exec
      summary: Run a program through the host and report its output.
      output: stream<string>
      argument_mode: expression
      capabilities: [process.exec]
      examples:
        - get echo-exec --program /bin/true
    - id: $2.command.signal
      verb: get
      target: echo-signal
      summary: Send a signal to a process through the host.
      output: stream<string>
      argument_mode: expression
      capabilities: [process.signal]
      examples:
        - get echo-signal --pid 1 --signal TERM
  CONTRIB
  }
  catalog() {
    cat > "$home/config/ono/kuang/catalogs/$1.yaml" <<CATALOG
  format: kuang-catalog/1
  catalog:
    name: $1
    description: A test catalog.
  entries:
    - id: $2
      name: $3
      description: A package from the catalog.
      publisher: dev.example
      releases:
        - version: $4
          platforms: [linux-amd64, linux-arm64]
          kuang_api: ">=11.1 <12"
          artifact: "git:https://example.invalid/$3#v$4"
  CATALOG
  }
  lay_out "$home/sources" dev.example.echo echo 0.1.0 "$home/home/.kube/config"
  catalog test dev.example.echo echo 0.1.0
  ono -c 'install plugin echo --confirm | count' > /dev/null

  echo "== a mutation before elevation: the permission first, the elevation named (K11P §26.4, §36.7) =="
  ono -c 'echo:signal --pid 1 --signal TERM' 2>&1 | head -2
  ono -c 'get capability --plugin dev.example.echo | where capability == "process.signal" | select decision | to json'

  echo "== an unattended widening needs --confirm; with it, the decision is made (K11P §20.2) =="
  ono -c 'set permission echo cluster-mutation --decision allow' 2>&1 | head -1
  ono -c 'set permission echo cluster-mutation --decision allow --confirm | select id state | to json'
  ono -c 'set permission echo cluster-mutation --decision deny | select id state | to json'
  ono -c 'echo:signal --pid 1 --signal TERM' 2>&1 | head -1

  echo "== the operate profile, named deliberately (K11P §15.2, §26.5) =="
  ono -c 'set permission echo --profile operate' 2>&1 | head -1
  ono -c 'set permission echo --profile operate --confirm | count' > /dev/null
  ono -c 'get permission echo | where id == "cluster-mutation" | select state profile | to json'
  ono -c 'set permission echo --profile nonesuch --confirm' 2>&1 | head -1

  echo "== a grant made by hand is custom, an unmapped one is legacy, and both stay visible (Gate L) =="
  ono -c 'grant capability filesystem.read --plugin dev.example.echo --scope "paths=/var/log/**" --duration always | count' > /dev/null
  ono -c 'grant capability filesystem.write --plugin dev.example.echo --scope "paths=/tmp/**" --duration always | count' > /dev/null
  ono -c 'get permission echo --all | where id == "kubeconfig-read" | select state | to json'
  ono -c 'get permission echo --all | where id == "capability:filesystem.write" | select state risk | to json'
  ono -c 'revoke capability filesystem.write --plugin dev.example.echo | select status | to json'
exit: 0
stdout-contains: Ono-Sendai-K11305
stdout-contains: Change resources
stdout-contains: set permission echo cluster-mutation
stdout-contains: {"decision":"deny"}
stdout-contains: Ono-Sendai-K11309
stdout-contains: {"id":"cluster-mutation","state":"allowed"}
stdout-contains: {"id":"cluster-mutation","state":"denied"}
stdout-contains: Ono-Sendai-K11301
stdout-contains: {"state":"allowed","profile":"operate"}
stdout-contains: Ono-Sendai-K11306
stdout-contains: {"state":"custom"}
stdout-contains: {"state":"legacy","risk":"destructive"}
stdout-contains: {"status":"success"}
stdout-not-contains: panicked
