# #156, ADR-1000 (spec §31.22, §31.46, §31.75; K11P §6.6): a contributed command that needs a
# `mutate` or `destructive` capability declares its risk, and never below the capability's. A
# declaration that does not is refused at registration and reported by `get plugin` — which
# package, which command, which capability, what is missing — and never reaches `get command`.
case: a mutating contribution without a risk is refused and reported
timeout: 120
run: |
  home=$(mktemp -d)
  export ONO_PLUGIN_PATH="$home/plugins"
  export XDG_STATE_HOME="$home/state"
  export XDG_CONFIG_HOME="$home/config"
  mkdir -p "$home/plugins/dev.example.echo/runtime" "$home/plugins/dev.example.echo/contributions"
  cp /usr/local/bin/kuang-example-plugin "$home/plugins/dev.example.echo/runtime/echo"
  cat > "$home/plugins/dev.example.echo/manifest.yaml" <<'MANIFEST'
  format: kuang-package/1
  package:
    id: dev.example.echo
    name: echo
    version: 0.1.0
    description: Emits what it is asked to emit.
    publisher: dev.example
    license: MIT
  compatibility:
    kuang_api: ">=11.1 <12"
    ono_language: ">=0.2"
    platforms: [linux-amd64, linux-arm64]
  runtime:
    kind: native-process
    entry: runtime/echo
    memory_max: 64MiB
    cpu_budget: interactive
    startup: lazy
  roles: [provider]
  network:
    outbound: none
  contributions:
    commands: [contributions/commands.yaml]
  MANIFEST
  declare() {
    cat > "$home/plugins/dev.example.echo/contributions/commands.yaml" <<CONTRIB
  commands:
    - id: dev.example.echo.command.emit
      verb: get
      target: echo-item
      summary: Emit a counted stream of integers.
      output: stream<int>
      argument_mode: expression
      capabilities: [network.connect]
  $1
      examples:
        - get echo-item --count 3
  CONTRIB
  }

  echo "== a mutating capability and no risk: refused and reported (ADR-1000) =="
  declare ""
  ono -c 'get plugin' 2>&1 >/dev/null | grep -F 'dev.example.echo.command.emit'
  echo "registered without a risk: $(ono -c 'get command | where id == "dev.example.echo.command.emit" | count | to json')"

  echo "== a risk below the capability's: refused the same way (K11P §6.6) =="
  declare "    risk: read"
  ono -c 'get plugin' 2>&1 >/dev/null | grep -F 'risk: read'

  echo "== the risk declared: registered, and help shows it (§31.22) =="
  declare "    risk: mutate"
  echo "registered with its risk: $(ono -c 'get command | where id == "dev.example.echo.command.emit" | count | to json')"
  ono -c 'help get echo-item' | grep -E 'mutate'
exit: 0
stdout-contains: package `dev.example.echo` declares no `risk:` for it, and it needs `network.connect`, whose risk is `mutate`
stdout-contains: package `dev.example.echo` declares `risk: read`, and it needs `network.connect`, whose risk is `mutate`
stdout-contains: registered without a risk: [0]
stdout-contains: registered with its risk: [1]
stdout-not-contains: panicked
