# Spec §31.20, issue #203, ADR-1016: this shell keeps no secret store, and `secrets.request`
# issues no handle rather than a fake one. A request inside the granted scope is refused with
# `provider.unavailable`, saying why; a variable in the shell's environment that carries the
# secret's name is never read as a store; a name outside the grant is refused at the broker and
# the trail records the name that was asked for.
case: a secret request meets a shell that keeps no store, honestly and without the environment
timeout: 120
run: |
  home=$(mktemp -d)
  export ONO_PLUGIN_PATH="$home/plugins"
  export XDG_STATE_HOME="$home/state"
  export XDG_CONFIG_HOME="$home/config"
  mkdir -p "$home/plugins/dev.example.echo/runtime"
  cp /usr/local/bin/kuang-example-plugin "$home/plugins/dev.example.echo/runtime/echo"
  cat > "$home/plugins/dev.example.echo/manifest.yaml" <<'MANIFEST'
  format: kuang-package/1
  package:
    id: dev.example.echo
    name: echo
    version: 0.1.0
    description: Emits what it is asked to emit.
    publisher: dev.example
    license: MIT
  compatibility:
    kuang_api: ">=11.1 <12"
    ono_language: ">=0.2"
    platforms: [linux-amd64, linux-arm64]
  runtime:
    kind: native-process
    entry: runtime/echo
    memory_max: 64MiB
    cpu_budget: interactive
    startup: lazy
  roles: [provider]
  capabilities:
    optional:
      - secret.use: {secrets: ["api-token"]}
  network:
    outbound: none
  MANIFEST
  grant='grant capability secret.use --plugin dev.example.echo --scope "secrets=api-token" | count; load plugin dev.example.echo'

  echo "== a granted request is refused, saying why, and no handle is issued =="
  API_TOKEN=hunter2-ambient ONO_SECRET_API_TOKEN=hunter2-ambient ono -c "$grant; try { echo:secret --name api-token } catch e { \$e | select name message | to json }" > "$home/granted.out" 2>&1
  grep -q 'provider.unavailable' "$home/granted.out" && grep -q 'keeps no secret store' "$home/granted.out" && echo "no-store-said-plainly"
  grep -q 'handle:' "$home/granted.out" || echo "no-handle-issued"
  grep -q 'hunter2' "$home/granted.out" || echo "environment-never-read"

  echo "== a name outside the grant is refused at the broker, and the trail names it =="
  ono -c "$grant; try { echo:secret --name db-password } catch e { \$e | select name | to json }; get audit --plugin dev.example.echo | where action == \"secrets.request\" | select result target | to json" > "$home/outside.out" 2>&1
  grep -q 'capability.scope_violation' "$home/outside.out" && grep -q 'db-password' "$home/outside.out" && echo "outside-scope-refused-and-recorded"
exit: 0
stdout-contains: no-store-said-plainly
stdout-contains: no-handle-issued
stdout-contains: environment-never-read
stdout-contains: outside-scope-refused-and-recorded
stdout-not-contains: panicked
