# Issue #163, ADR-0936: a diagnostic nobody reads is not a reason to crash. With standard error a
# pipe whose reader has already gone, `ono` used to panic on its own diagnostic and exit 101; the
# refusal's status is what a script or a supervisor reading `$?` must see. Each `ono` starts after
# `head -c0` has exited, so the pipe is closed before anything is written.
case: a refusal nobody reads the diagnostics of still exits with the refusal's own status
run: |
  (sleep 0.3; exec ono --definitely-not-a-flag) 2>&1 | head -c0
  echo "usage=${PIPESTATUS[0]}"
  (sleep 0.3; exec ono -c 'no-such-command-anywhere') 2>&1 | head -c0
  echo "unknown-command=${PIPESTATUS[0]}"
  (sleep 0.3; exec ono -c 'get process | where cpy > 1') 2>&1 | head -c0
  echo "type-error=${PIPESTATUS[0]}"
  (sleep 0.3; XDG_CONFIG_HOME=/dev/null/config exec ono --print-peer-key) 2>&1 | head -c0
  echo "peer-key=${PIPESTATUS[0]}"
exit: 0
stdout-contains: usage=2
stdout-contains: unknown-command=127
stdout-contains: type-error=1
stdout-contains: peer-key=1
stdout-not-contains: =101
