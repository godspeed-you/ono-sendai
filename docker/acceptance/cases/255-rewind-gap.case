# v0.5 section 18.5, section 18.6, section 55.5. A cursor that steps into a coverage gap shows the
# gap: the interval, the reason and the last instant anything was known. It never continues showing
# the last state with a silently advancing timestamp, and no frame is interpolated between
# unsupported states (ADR-0685).
case: a cursor inside a coverage gap shows the gap rather than the last state
timeout: 180
env: NO_COLOR=1
run: |
  echo "== a session with no recorder has an uncovered past everywhere (section 7.5) =="
  ono --no-config -c 'at -10m; look' > /tmp/gap.txt 2>&1 || true
  cat /tmp/gap.txt
  if grep -qi 'gap\|not_recorded\|not recorded\|not known at requested time\|unknown' /tmp/gap.txt; then
    echo "an-uncovered-instant-is-named-as-one"
  else
    echo "WRONG an uncovered instant answered as if it were covered"
  fi

  echo "== the coverage behind an answer is inspectable (section 8.5, section 11.7) =="
  ono --no-config -c 'at -10m; look --json' > /tmp/gap.json 2>&1 || true
  head -c 400 /tmp/gap.json; echo
  if grep -qi 'panicked' /tmp/gap.json; then
    echo "WRONG a gap panicked"
  else
    echo "a-gap-is-an-answer"
  fi

  echo done=ok
exit: 0
stdout-contains: an-uncovered-instant-is-named-as-one
stdout-contains: a-gap-is-an-answer
stdout-contains: done=ok
stdout-not-contains: WRONG
stdout-not-contains: panicked
