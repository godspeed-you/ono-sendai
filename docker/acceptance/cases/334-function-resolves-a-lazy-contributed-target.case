# v0.6.1 §6, §28, issue #130 (spec §31.68): a function body resolves `get <target>` the way the
# prompt does. A target an installed package contributes answers typed, through an alias, and from
# a function followed by further stages, each in a session of its own with nothing loaded, so each
# form is the first use that loads the package. Before the fix the function form failed with
# `resolve.command_not_found … is declared but this build implements nothing for it`.
case: a function body answers a contributed target of a lazy package as the prompt does
timeout: 120
run: |
  home=$(mktemp -d)
  export ONO_PLUGIN_PATH="$home/plugins"
  export XDG_STATE_HOME="$home/state"
  export XDG_CONFIG_HOME="$home/config"
  mkdir -p "$home/plugins/dev.example.echo/runtime" "$home/plugins/dev.example.echo/contributions"
  cp /usr/local/bin/kuang-example-plugin "$home/plugins/dev.example.echo/runtime/echo"
  cat > "$home/plugins/dev.example.echo/manifest.yaml" <<'MANIFEST'
  format: kuang-package/1
  package:
    id: dev.example.echo
    name: echo
    version: 0.1.0
    description: Emits what it is asked to emit.
    publisher: dev.example
    license: MIT
  compatibility:
    kuang_api: ">=11.1 <12"
    ono_language: ">=0.2"
    platforms: [linux-amd64, linux-arm64]
  runtime:
    kind: native-process
    entry: runtime/echo
    memory_max: 64MiB
    cpu_budget: interactive
    startup: lazy
  roles: [provider]
  capabilities:
    optional:
      - clock.read
  network:
    outbound: none
  contributions:
    targets: [contributions/targets.yaml]
  MANIFEST
  cat > "$home/plugins/dev.example.echo/contributions/targets.yaml" <<'CONTRIB'
  targets:
    - name: echo-item
      schema: dev.example.echo.item/1
      summary: Items the example package provides.
      identity_doc: Two observations are the same item when their `seq` matches.
  CONTRIB

  echo "== typed, aliased and called from a function, each the first use of the package =="
  echo "typed: $(ono -c 'get echo-item --count 2 | select seq | to json' 2>&1)"
  echo "alias: $(ono -c 'alias items = get echo-item; items --count 2 | select seq | to json' 2>&1)"
  echo "function: $(ono -c 'fn items(n: Int = 2) { get echo-item --count $n }; items | select seq | to json' 2>&1)"
  echo "bare function: $(ono -c 'fn items() { get echo-item }; items | count | to json' 2>&1)"
exit: 0
stdout-contains: typed: [{"seq":1},{"seq":2}]
stdout-contains: alias: [{"seq":1},{"seq":2}]
stdout-contains: function: [{"seq":1},{"seq":2}]
stdout-contains: bare function: [3]
stdout-not-contains: command_not_found
stdout-not-contains: implements nothing
stdout-not-contains: panicked
