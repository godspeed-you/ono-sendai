# v0.6 §50 phase P8 — §10.3, §55.6 cases 27 and 28, and §62.6: the plan-level protection summary
# never hides the matrix beneath it, and protection is never rendered without what it leaves out.
#
# The two scenarios §55.6 names are the ones a reasonable implementation gets wrong. A plan that
# snapshots a filesystem and kills a process is not protected for the process — §33.1 says a
# filesystem snapshot does not change that classification. A plan that snapshots a filesystem and
# makes an outbound call is not protected for the call — §35.2 says the request has been served.
# Both stay in the `not covered` block after protection, and that is §2.13.
case: protection is a matrix with its exclusions beside it, never a word on its own
timeout: 120
env: NO_COLOR=1
run: |
  prove() {
    local id="$1" what="$2" check="$3" out
    if out=$(eval "$check" 2>&1); then
      printf 'PROVED %s: %s\n' "$id" "$what"
    else
      printf 'FAILED %s: %s\n' "$id" "$what"
      printf '%s\n' "$out" | head -6 | sed 's/^/        /'
    fi
  }

  mkdir -p "$HOME/etc"
  printf 'worker_processes 4;\n' > "$HOME/etc/nginx.conf"
  printf 'worker_processes 8;\n' > "$HOME/etc/nginx.conf.new"

  echo '== §10.3: the plan carries one row per mutation domain =='
  ono -c "plan replace file $HOME/etc/nginx.conf from $HOME/etc/nginx.conf.new | to json" > /tmp/m1.json 2>&1
  prove m1a "the record carries a protection matrix, not a boolean (§10.1)" \
    'grep -q "\"protection\"" /tmp/m1.json'
  prove m1b "and a level composed from it (§10.2, Appendix A.5)" \
    'grep -q "\"protection_level\"" /tmp/m1.json'
  prove m1c "and the exclusions that travel with the level (§10.3, §62.6)" \
    'grep -q "coverage_exclusions" /tmp/m1.json'
  prove m1d "the level is one of §10.2's six words and nothing else" \
    'grep -oE "\"protection_level\": *\"[a-z-]+\"" /tmp/m1.json | grep -qE "unprotected|compensatable|partially-protected|protected|transactional|unknown"'

  echo '== §55.6 case 27: a signal is unprotected for runtime state, whatever the filesystem offers =='
  sleep 600 &
  victim=$!
  ono -c "plan kill process $victim --signal SIGKILL | to json" > /tmp/m2.json 2>&1
  prove m2a "a SIGKILL plan does not report itself protected (§33.1, §59.4)" \
    '! grep -q "\"protection_level\": *\"protected\"" /tmp/m2.json'
  prove m2b "and the process is still running, because planning changed nothing (§2.1)" \
    "kill -0 $victim"
  prove m2c "the runtime effect is marked irreversible (§2.13, §33.1)" \
    'grep -q "irreversible" /tmp/m2.json'
  kill $victim 2>/dev/null || true

  echo '== §20.4 and Appendix E.8: the rendered view shows the exclusions with the word =='
  ono -c "plan replace file $HOME/etc/nginx.conf from $HOME/etc/nginx.conf.new" > /tmp/m3.txt 2>&1
  prove m3a "the plan view carries a protection block (§20.4)" \
    'grep -qi "^protection" /tmp/m3.txt'
  prove m3b "and it names what is not covered beside it (§10.3, §62.6, Appendix E.8)" \
    'grep -qiE "not covered|not recoverable" /tmp/m3.txt'
  prove m3c "no rendering reduces protection to a single reassuring mark (Appendix E.8)" \
    '! grep -qiE "^ *(safe|fully protected|reversible: *(true|yes))" /tmp/m3.txt'

  echo '== §62.1: a plan on a filesystem with no snapshot provider says so honestly =='
  prove m3d "an unprotected domain is reported rather than omitted (§10.2, §62.1)" \
    'grep -qiE "protection" /tmp/m3.txt'

  echo 'protection-is-a-matrix: done'
exit: 0
stdout-contains: PROVED m1a
stdout-contains: PROVED m1b
stdout-contains: PROVED m1c
stdout-contains: PROVED m1d
stdout-contains: PROVED m2a
stdout-contains: PROVED m2b
stdout-contains: PROVED m2c
stdout-contains: PROVED m3a
stdout-contains: PROVED m3b
stdout-contains: PROVED m3c
stdout-contains: PROVED m3d
stdout-contains: protection-is-a-matrix: done
stdout-not-contains: FAILED
stdout-not-contains: panicked
