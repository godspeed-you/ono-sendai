# Phase D (spec §37): completion is semantic — candidates come from the registries, not from a
# wordlist. `get proc<TAB>` completes to the declared target `process` because the contract says
# `get` takes one, and the completed pipeline then actually runs.
#
# Spec §15.1 also wants completion to be *provider-aware*, which the registries cannot be: a user
# account is not in any contract. `get user ro<TAB>` completes to an account this container
# actually has, from the provider, inside the budget of §34 (ADR-0252).
case: completion answers from the registries on a real terminal
pty: true
columns: 100
lines: 30
timeout: 60
stdin: |
  get proc	 | count
  get user ro	 | count
  exit
run: |
  ono
exit: 0
stdout-contains: get process
stdout-contains: get user root
stdout-contains: VALUE
