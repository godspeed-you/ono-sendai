# Spec §34's pathological environments, second of four: a host with thousands of sockets and
# connections. See case `151` for what this series is and how the figures are taken.
#
# Unix domain sockets, because the acceptance container runs with networking disabled; they reach
# the provider through `sock_diag` exactly as any other listener does.
#
# What the case does when the machine cannot meet the budget (ADR-0882). Every figure is a whole
# `ono` process, so part of it is the machine's own speed, and in this container the ordinary
# host's first socket row alone costs 35-48ms of the 50ms budget: one full run at load 6.8 read
# 48ms there and then 51ms and 56ms on the pathological host, and reported both as OVER BUDGET,
# two milliseconds from the edge (issue #189). So every row is judged in two steps, and says which
# one it passed:
#
# - its median against the budget, exactly as before; and, only where that misses,
# - what the row costs at the fastest of its runs against what the same machine costs in the same
#   run without it. For a pathological row the reference is the same statement on the ordinary
#   host, measured before the fixture opens its sockets and again after it has closed them, and
#   the pathology may add at most half the budget to it. For the ordinary host's own row the
#   fastest of its runs must itself be within the budget.
#
# The fastest run is the figure a busy machine disturbs least, so this step reads the product's
# own cost rather than the machine's load; a pathology that genuinely costs more than half the
# budget still fails, however quiet or busy the machine is.
case: the budgets of section 34 hold on a host with thousands of sockets
timeout: 600
env: NO_COLOR=1
run: |
  # The median and the fastest of `runs` whole `ono` runs of `statement`, in milliseconds.
  figure_of() {
    local runs="$1" statement="$2"
    ono --no-config -c "$statement" >/dev/null 2>&1
    for _ in $(seq "$runs"); do
      local start end
      start=$(date +%s%N)
      ono --no-config -c "$statement" >/dev/null 2>&1
      end=$(date +%s%N)
      echo $(( (end - start) / 1000000 ))
    done | sort -n | awk '{ v[NR] = $1 } END { if (NR == 0) { print -1, -1 } else { print v[int((NR + 1) / 2)], v[1] } }'
  }

  # The ordinary host: each statement measured before the fixture and again after it. MEDIAN keeps
  # the quieter median, FASTEST the fastest single run of either pass.
  declare -A MEDIAN FASTEST
  reference() {
    local label="$1" runs="$2" statement="$3" median fastest
    read -r median fastest < <(figure_of "$runs" "$statement")
    echo "$label: ${median}ms, fastest ${fastest}ms (ordinary host, $runs runs, $statement)"
    if [ -z "${MEDIAN[$label]}" ] || [ "$median" -lt "${MEDIAN[$label]}" ]; then MEDIAN[$label]=$median; fi
    if [ -z "${FASTEST[$label]}" ] || [ "$fastest" -lt "${FASTEST[$label]}" ]; then FASTEST[$label]=$fastest; fi
  }
  references() {
    reference ordinary-first-socket-row 20 'get socket | take 1'
    reference ordinary-first-connection-row 20 'get connection | take 1'
    reference ordinary-start 20 'true'
    reference ordinary-socket-table 5 'get socket | count'
  }

  # The ordinary host's row: its median against the budget, or else its fastest run.
  judge() {
    local label="$1" limit_ms="$2" ref_label="$3" runs="$4" statement="$5" median fastest
    median=${MEDIAN[$ref_label]}
    fastest=${FASTEST[$ref_label]}
    echo "$label: ${median}ms (§34 budget ${limit_ms}ms, median of $runs runs, $statement)"
    if [ "$median" -le "$limit_ms" ]; then
      echo "$label: within budget"
    elif [ "$fastest" -le "$limit_ms" ]; then
      echo "$label: within budget on this machine: the median is the machine's, and the fastest run answered in ${fastest}ms (ADR-0882)"
    else
      echo "$label: OVER BUDGET: not one run of the ordinary host answered within ${limit_ms}ms (fastest ${fastest}ms)"
    fi
  }

  # A pathological row: its median against the budget, or else what it adds at its fastest run to
  # the same statement's fastest run on the ordinary host, against half the budget.
  judge_against() {
    local label="$1" limit_ms="$2" median="$3" fastest="$4" runs="$5" statement="$6" ref_label="$7" added
    added=$(( fastest - FASTEST[$ref_label] ))
    echo "$label: ${median}ms (§34 budget ${limit_ms}ms, median of $runs runs, $statement)"
    if [ "$median" -le "$limit_ms" ]; then
      echo "$label: within budget"
    elif [ "$added" -le $(( limit_ms / 2 )) ]; then
      echo "$label: within budget on this machine: the median is the machine's, and at its fastest run the pathology adds ${added}ms to ${ref_label}'s ${FASTEST[$ref_label]}ms, within half the ${limit_ms}ms budget (ADR-0882)"
    else
      echo "$label: OVER BUDGET: at its fastest run the pathology adds ${added}ms to ${ref_label}'s ${FASTEST[$ref_label]}ms, more than half the ${limit_ms}ms budget"
    fi
  }

  echo "== the ordinary host =="
  echo "sockets before: $(ono --no-config -c 'get socket | count')"
  references

  echo "== the pathological host =="
  perl /opt/ono-fixtures/perf/many-sockets.pl 5000 /tmp/many-sockets /tmp/many-sockets.state &
  for _ in $(seq 600); do [ -s /tmp/many-sockets.state ] && break; sleep 0.5; done
  . /tmp/many-sockets.state
  echo "fixture: asked for 5000, opened $FIXTURE_SOCKETS listening unix sockets"
  if [ "$FIXTURE_SOCKETS" -lt 2000 ]; then echo "TOO-FEW-SOCKETS"; else echo "the host is pathological"; fi
  echo "counted: $(ono --no-config -c 'get socket | count')"

  read -r socket_row socket_row_fastest < <(figure_of 20 'get socket | take 1')
  read -r connection_row connection_row_fastest < <(figure_of 20 'get connection | take 1')
  read -r start_row start_row_fastest < <(figure_of 20 'true')
  read -r socket_table socket_table_fastest < <(figure_of 5 'get socket | count')

  kill %1 2>/dev/null || true
  jobs -p | xargs -r kill 2>/dev/null || true
  wait 2>/dev/null || true

  echo "== the ordinary host again, after the fixture =="
  echo "sockets after: $(ono --no-config -c 'get socket | count')"
  references

  echo "== the verdicts =="
  judge baseline-first-socket-row 50 ordinary-first-socket-row 20 'get socket | take 1'
  judge_against first-socket-row 50 "$socket_row" "$socket_row_fastest" 20 'get socket | take 1' ordinary-first-socket-row
  judge_against first-connection-row 50 "$connection_row" "$connection_row_fastest" 20 'get connection | take 1' ordinary-first-connection-row
  judge_against cold-start-under-load 100 "$start_row" "$start_row_fastest" 20 'true' ordinary-start
  judge_against whole-socket-table 5000 "$socket_table" "$socket_table_fastest" 5 'get socket | count' ordinary-socket-table
exit: 0
stdout-contains: the host is pathological
stdout-contains: baseline-first-socket-row: within budget
stdout-contains: first-socket-row: within budget
stdout-contains: first-connection-row: within budget
stdout-contains: cold-start-under-load: within budget
stdout-contains: whole-socket-table: within budget
stdout-not-contains: OVER BUDGET
stdout-not-contains: TOO-FEW-SOCKETS
stdout-not-contains: panicked
stdout-not-contains: Ono-Sendai-E
