# v0.6 §50 phase P2 — §29 and §63.15: a remote whose state could not be established stays
# unknown.
#
# §29.3 is the rule this case exists for: a host whose outcome could not be established is
# `UNKNOWN`, not a failure and not a success, and Appendix F.2 says the same of an action. The
# link's local transport makes a second host of the same container, and a plan made through it
# that kills the agent answering for the link drops the link in the middle of its own action: the
# request goes out and its answer never comes back. §29.4's per-host recovery then says which host
# it cannot proceed on, and §34.2's link-loss landmark is proved over a loopback `tcp` link, the
# one network the container has.
case: an unlinked remote is refused, a link that drops mid-action leaves it unknown, and a plan that would cut the link is critical
timeout: 180
env: NO_COLOR=1
run: |
  prove() {
    local id="$1" what="$2" check="$3" out
    if out=$(eval "$check" 2>&1); then
      printf 'PROVED %s: %s\n' "$id" "$what"
    else
      printf 'FAILED %s: %s\n' "$id" "$what"
      printf '%s\n' "$out" | head -6 | sed 's/^/        /'
    fi
  }

  mkdir -p "$HOME/etc" "$HOME/.config/ono"
  printf 'a\n' > "$HOME/etc/a"
  printf 'b\n' > "$HOME/etc/b"

  echo '== §29.1: a host nobody linked is a refusal, with a code =='
  ono -c 'trace host no-such-host-1a2b' > /tmp/rd1.txt 2>&1
  status=$?
  prove rd1a "tracing an unknown host is refused as a target that does not resolve (v0.4.1 §9, v0.2 §43)" \
    'grep -q "Ono-Sendai-E0102 resolve.target_not_found" /tmp/rd1.txt'
  prove rd1b "and it exits non-zero, without claiming anything happened (§2.4)" \
    "[ $status -ne 0 ] && ! grep -qiw 'success' /tmp/rd1.txt"
  ono -c 'test host no-such-host-1a2b' > /tmp/rd2.txt 2>&1
  status=$?
  prove rd1c "testing it answers that the link is not available, as a refusal (v0.4.1 §9, §29.3)" \
    "[ $status -ne 0 ] && grep -q 'Ono-Sendai-E0601 remote.unreachable' /tmp/rd2.txt"

  echo '== §22.1 and §29.2: one ledger, and the refusal left no plan in it =='
  ono -c "trace host no-such-host-1a2b
  plan copy file $HOME/etc/a $HOME/etc/b --overwrite | to json
  find event | to json" > /tmp/rd3.txt 2>&1
  prove rd2a "in one session, the only plan the ledger records is the local one planned beside the refusal (§22.1)" \
    "[ \"\$(grep -o '\"subtype\":\"ono.plan.created\"' /tmp/rd3.txt | wc -l)\" -eq 1 ]"

  echo '== §29.3, §41.1 and Appendix F.2: the shell has a word for an outcome nobody established =='
  # §6.3's escape is the one action whose idempotency no contract can state; the plan records it
  # as `unknown` rather than guessing either way.
  printf 'set config change.allow_opaque_actions true\n' > "$HOME/.config/ono/config.ono"
  ono -c "plan --opaque sh -c 'true' | select actions | to json" > /tmp/rd4.json 2>&1
  prove rd3a "an action whose idempotency cannot be established is sealed as \`unknown\` (§41.1, §6.3)" \
    'grep -q "\"idempotency\":\"unknown\"" /tmp/rd4.json'
  ono -c "plan --opaque sh -c 'true' | to json" > /tmp/rd5.json 2>&1
  prove rd3b "and the plan's risk is \`unknown\`, not promoted to a class nobody measured (§2.4, §19.2)" \
    'grep -q "\"risk\":\"unknown\"" /tmp/rd5.json'
  rm -f "$HOME/.config/ono/config.ono"
  prove rd3c "every verification contract says a timeout is failed or unknown, never passed (§23.5)" \
    "ono -c 'plan copy file $HOME/etc/a $HOME/etc/b --overwrite | to json' 2>&1 | grep -qE '\"timeout_status\":\"(failed|unknown)\"'"

  echo '== §29.3 and Appendix F.2: a link that drops under an action leaves it unknown =='
  # A home of its own: the plan below stays `applying` by design, and no later case should find it.
  HOME=$(mktemp -d)
  export HOME
  unset XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME
  cd "$HOME"
  ono -c "link host l1 --transport local; enter link l1; get process | where \"--agent\" in command | where cwd == \"$HOME\" | plan kill process | apply --accept-risk --accept-irreversible --confirm" > /tmp/rd6.txt 2>&1
  prove rd4a "the action whose answer never came back is unknown, never failed (§29.3, Appendix F.2)" \
    'grep -q "change.remote_state_unknown" /tmp/rd6.txt && ! grep -q "change.apply_failed" /tmp/rd6.txt'
  ono -c 'get plan | select id state | to json' > /tmp/rd7.json 2>&1
  prove rd4b "and the plan stays applying until the host can be asked again (Appendix F.2, §63.15)" \
    'grep -q "\"state\":\"applying\"" /tmp/rd7.json'

  echo '== §29.4: recovery is planned per host, and says where it cannot proceed =='
  plan=$(sed -n 's/^\[{"id":"\([0-9a-f]\{8\}\).*/\1/p' /tmp/rd7.json)
  ono -c "link host l1 --transport local; enter link l1; recover $plan" > /tmp/rd8.txt 2>&1
  status=$?
  prove rd5a "recovery refuses on the host whose state could not be established, and names it (§29.4, §29.3)" \
    "[ $status -ne 0 ] && grep -q 'change.remote_state_unknown' /tmp/rd8.txt && grep -q 'l1' /tmp/rd8.txt"

  echo '== §34.2: a network plan threatening the active remote link is CRITICAL =='
  CLIENT_KEY=$(ono --print-peer-key)
  HOST_KEY=$(ono --agent --host-key "$HOME/agent.pem" --print-host-key)
  ono -c "add host-key 127.0.0.1 --fingerprint $HOST_KEY" > /dev/null 2>&1
  ono -c "add client-key $CLIENT_KEY --label case-308" > /dev/null 2>&1
  ono --agent --listen 127.0.0.1:7743 --host-key "$HOME/agent.pem" 2> "$HOME/agent.log" &
  AGENT=$!
  for _ in $(seq 1 50); do grep -q 'listening on' "$HOME/agent.log" && break; sleep 0.2; done
  ono -c 'link host 127.0.0.1:7743 --transport tcp; plan stop interface lo | to json' > /tmp/rd9.json 2>&1
  prove rd6a "stopping the interface the active link leaves by is a CRITICAL landmark (§34.2, Appendix I.3)" \
    'grep -q "\"class\":\"critical\",\"rule\":\"risk.remote.link-loss\"" /tmp/rd9.json && grep -q "\"risk\":\"critical\"" /tmp/rd9.json'
  ono -c 'plan stop interface lo | to json' > /tmp/rd10.json 2>&1
  prove rd6b "and with no link held the same plan makes no such claim (§34.2)" \
    'grep -q "\"risk_findings\"" /tmp/rd10.json && ! grep -q "risk.remote.link-loss" /tmp/rd10.json'
  kill "$AGENT" 2>/dev/null || true
  wait "$AGENT" 2>/dev/null || true
  echo 'remote-disconnect: done'
exit: 0
stdout-contains: PROVED rd1a
stdout-contains: PROVED rd1b
stdout-contains: PROVED rd1c
stdout-contains: PROVED rd2a
stdout-contains: PROVED rd3a
stdout-contains: PROVED rd3b
stdout-contains: PROVED rd3c
stdout-contains: PROVED rd4a
stdout-contains: PROVED rd4b
stdout-contains: PROVED rd5a
stdout-contains: PROVED rd6a
stdout-contains: PROVED rd6b
stdout-contains: remote-disconnect: done
stdout-not-contains: FAILED
stdout-not-contains: SKIPPED
stdout-not-contains: panicked
