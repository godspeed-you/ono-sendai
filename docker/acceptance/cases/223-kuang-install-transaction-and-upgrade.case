# K11P §12.4, §21, §34.4, §34.5 (ADR-0601 §4, ADR-0602 §1, ADR-0604 §3): an install that fails
# after the package was placed leaves nothing behind; an upgrade that asks for nothing new keeps
# every decision; one that widens a scope under a reused permission id needs renewed consent and
# leaves the installed version intact when it does not get it; and a package signed by an
# unrelated key is not an update. Gates N, O, U.
case: an install is a transaction, and an upgrade keeps authority only by consent
timeout: 240
run: |
  home=$(mktemp -d)
  export ONO_PLUGIN_PATH="$home/plugins"
  export ONO_PLUGIN_SOURCES="$home/sources"
  export ONO_SYSTEM_CONFIG_DIR="$home/system"
  export HOME="$home/home"
  export XDG_STATE_HOME="$home/state"
  export XDG_CONFIG_HOME="$home/config"
  export XDG_CACHE_HOME="$home/cache"
  export ONO_CONFIG_DIR="$home/config/ono"
  mkdir -p "$home/plugins" "$home/home" "$home/config/ono/kuang/catalogs"
  # A `kuang-package/2` package in the shape of the reference provider (K11P §8.2), over the
  # example runtime: observation recommended, relationships automatic, a login helper asked
  # just in time, mutation explicit.
  lay_out() {
    mkdir -p "$1/$2/runtime" "$1/$2/contributions"
    cp /usr/local/bin/kuang-example-plugin "$1/$2/runtime/echo"
    cat > "$1/$2/manifest.yaml" <<MANIFEST
  format: kuang-package/2
  package:
    id: $2
    name: $3
    version: $4
    description: Emits what it is asked to emit.
    publisher: dev.example
    license: MIT
  compatibility:
    kuang_api: ">=11.2 <12"
    ono_language: ">=0.2"
    platforms: [linux-amd64, linux-arm64]
  runtime:
    kind: native-process
    entry: runtime/echo
    memory_max: 64MiB
    cpu_budget: interactive
    startup: lazy
  roles: [provider]
  capabilities:
    optional:
      - network.connect
      - process.signal
      - filesystem.read: {paths: ["$5"]}
      - secret.use
      - clock.read
      - relation.write
      - process.exec
  network:
    outbound: none
  contributions:
    commands: [contributions/commands.yaml]
  permissions:
    profiles:
      minimal: {title: Minimal, permissions: [spatial-relations]}
      recommended: {title: Recommended, permissions: [cluster-access, kubeconfig-read, credential-use, spatial-relations]}
      operate: {title: Observe and change, permissions: [cluster-access, kubeconfig-read, credential-use, spatial-relations, cluster-mutation]}
    requests:
      - {id: cluster-access, kind: external-observe, title: Connect to clusters, phase: install, recommended: true, grants: [{capability: network.connect, scope: runtime-derived}]}
      - {id: kubeconfig-read, kind: filesystem-read, title: Read cluster configuration, phase: install, recommended: true, grants: [{capability: filesystem.read, scope: {paths: ["$5"]}}]}
      - {id: credential-use, kind: secret-use, title: Use credentials without exposing their values, phase: install, recommended: true, grants: [{capability: secret.use}]}
      - {id: spatial-relations, kind: local-contribution, title: Add relationships to Ono, phase: automatic, recommended: true, grants: [{capability: relation.write, scope: package-contributions}]}
      - {id: login-helper, kind: execute-helper, title: Run an external login helper when a context requires it, purpose: authenticate to the selected context, phase: jit, recommended: false, grants: [{capability: process.exec, scope: runtime-derived}]}
      - {id: cluster-mutation, kind: host-change, title: Change resources, phase: explicit, recommended: false, grants: [{capability: process.signal}]}
  MANIFEST
    cat > "$1/$2/contributions/commands.yaml" <<CONTRIB
  commands:
    - id: $2.command.emit
      verb: get
      target: echo-item
      summary: Emit a counted stream of integers.
      output: stream<int>
      argument_mode: expression
      capabilities: []
      examples:
        - get echo-item --count 3
    - id: $2.command.exec
      verb: get
      target: echo-exec
      summary: Run a program through the host and report its output.
      output: stream<string>
      argument_mode: expression
      capabilities: [process.exec]
      examples:
        - get echo-exec --program /bin/true
    - id: $2.command.signal
      verb: get
      target: echo-signal
      summary: Send a signal to a process through the host.
      output: stream<string>
      argument_mode: expression
      capabilities: [process.signal]
      examples:
        - get echo-signal --pid 1 --signal TERM
  CONTRIB
  }
  catalog() {
    cat > "$home/config/ono/kuang/catalogs/$1.yaml" <<CATALOG
  format: kuang-catalog/1
  catalog:
    name: $1
    description: A test catalog.
  entries:
    - id: $2
      name: $3
      description: A package from the catalog.
      publisher: dev.example
      releases:
        - version: $4
          platforms: [linux-amd64, linux-arm64]
          kuang_api: ">=11.1 <12"
          artifact: "git:https://example.invalid/$3#v$4"
  CATALOG
  }
  lay_out "$home/sources" dev.example.echo echo 0.1.0 "$home/home/.kube/config"
  catalog test dev.example.echo echo 0.1.0

  echo "== the decision store cannot be written: nothing is left behind (Gate U) =="
  mkdir -p "$home/config/ono/kuang" && chmod 0555 "$home/config/ono/kuang"
  ono -c 'install plugin echo --confirm' 2>&1 | head -1 > /dev/null
  chmod 0755 "$home/config/ono/kuang"
  test ! -d "$home/plugins/dev.example.echo" && test ! -f "$home/state/ono/kuang/dev.example.echo/management.json" && echo "rollback=clean"
  ono -c 'get plugin | count | to json'

  echo "== an upgrade that asks for nothing new keeps every decision (Gate N) =="
  ono -c 'install plugin echo --confirm | count' > /dev/null
  lay_out "$home/next" dev.example.echo echo 0.1.1 "$home/home/.kube/config"
  ono -c "install plugin path:$home/next/dev.example.echo --confirm | select status | to json; get plugin echo | select version readiness | to json"
  ono -c 'get permission echo | where id == "cluster-access" | select state | to json'

  echo "== a widened scope under the same permission id is new consent (K11P §34.5, Gate O) =="
  lay_out "$home/wide" dev.example.echo echo 0.1.2 "$home/home/**"
  ono -c "install plugin path:$home/wide/dev.example.echo" 2>&1 | head -1
  ono -c "install plugin path:$home/wide/dev.example.echo" 2>&1 | grep -q "scope-widened" && echo "delta=shown"
  ono -c 'get plugin echo | select version | to json'
  ono -c "install plugin path:$home/wide/dev.example.echo --confirm | select status | to json; get plugin echo | select version | to json"

  echo "== a package signed by an unrelated key is not an update (K11P §34.4) =="
  lay_out "$home/a" dev.example.other other 0.3.0 "$home/home/.kube/config"
  lay_out "$home/b" dev.example.other other 0.3.1 "$home/home/.kube/config"
  kuang-sign keygen --out "$home/key-a" > /dev/null; kuang-sign keygen --out "$home/key-b" > /dev/null
  kuang-sign sign "$home/a/dev.example.other" --key "$home/key-a" > /dev/null
  kuang-sign sign "$home/b/dev.example.other" --key "$home/key-b" > /dev/null
  ono -c "install plugin path:$home/a/dev.example.other --confirm | select status | to json"
  ono -c "install plugin path:$home/b/dev.example.other --confirm" 2>&1 | head -1
  ono -c 'get plugin other | select version | to json'
exit: 0
stdout-contains: rollback=clean
stdout-contains: [0]
stdout-contains: {"version":"0.1.1","readiness":"ready"}
stdout-contains: {"state":"allowed"}
stdout-contains: Ono-Sendai-E0701
stdout-contains: delta=shown
stdout-contains: {"version":"0.1.1"}
stdout-contains: {"version":"0.1.2"}
stdout-contains: Ono-Sendai-K11005
stdout-contains: {"version":"0.3.0"}
stdout-not-contains: panicked
