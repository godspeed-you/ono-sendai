# v0.4.1 §11.2 and §12, at the product. Phase H2 left a listening agent that authenticated and
# authorized every peer correctly and would hold as many of them as anyone cared to open; §12 is
# the section that says an agent a person exposes on a network cannot be exhausted by a peer that
# simply keeps connecting, and §11.2 is the block that agent must print before it accepts anybody.
#
# Everything here is loopback — the container runs with networking disabled — and every ceiling is
# set through the ordinary `limits.remote_*` configuration keys, so what this case proves is not
# only that the ceilings hold but that the figures an operator reads with `inspect limits`, the
# figures the startup summary prints and the figures the listener enforces are one set of numbers
# (§12.4, §52.2).
case: a listening agent says what it will accept, and stays inside it
timeout: 180
env: NO_COLOR=1
run: |
  HOME=$(mktemp -d)
  export HOME
  export XDG_CONFIG_HOME="$HOME"
  # One set of numbers, read by the agent, by `inspect limits` and by this case.
  export ONO_LIMITS_REMOTE_CONNECTIONS=8
  export ONO_LIMITS_REMOTE_CONNECTIONS_PER_CLIENT=2
  export ONO_LIMITS_REMOTE_PENDING_HANDSHAKES=1
  export ONO_LIMITS_REMOTE_HANDSHAKE_TIMEOUT_MS=500

  echo "== an agent prints what it has just exposed (section 11.2) =="
  ono --agent --listen 127.0.0.1:7736 2> "$HOME/agent.log" &
  AGENT=$!
  for _ in $(seq 1 100); do grep -q 'handshake timeout' "$HOME/agent.log" && break; sleep 0.2; done
  sed -n 's/^ono: //p' "$HOME/agent.log" | head -9

  echo "== the ceilings a user reads are the ceilings the agent enforces (section 12.4) =="
  ono -c 'inspect limits | where key == "limits.remote_connections" | select key value | to json'

  echo "== a peer that says nothing is dropped, and one over the ceiling never starts =="
  exec 3<>/dev/tcp/127.0.0.1/7736
  exec 4<>/dev/tcp/127.0.0.1/7736
  head -c 1 <&4 > /dev/null
  echo "the peer over the pending-handshake ceiling was closed at once"
  head -c 1 <&3 > /dev/null
  echo "the silent peer was dropped when its handshake budget ran out"
  exec 3<&-
  exec 4<&-
  grep -o 'event=connection.limit_denied' "$HOME/agent.log" | head -1
  grep -o 'error_code=remote.connection_limit' "$HOME/agent.log" | head -1

  echo "== and a legitimate client is served afterwards (section 12.6) =="
  HOSTKEY=$(sed -n 's/.*host key //p' "$HOME/agent.log" | head -1)
  CLIENT=$(ono --print-peer-key)
  ono -c "add host-key 127.0.0.1 --fingerprint $HOSTKEY | select status | to json"
  ono -c "add client-key $CLIENT --label operator | select status | to json"
  ono -c 'link host 127.0.0.1:7736 --transport tcp; enter link 127.0.0.1:7736; get process | count | to json' | tail -1

  echo "== revoking a client says what it does, and does it (section 12.5) =="
  ono -c "remove client-key $CLIENT | select message | to json"
  ono -c 'try { link host 127.0.0.1:7736 --transport tcp } catch e { $e | select code name | to json }'
  kill "$AGENT" 2>/dev/null || true
  wait "$AGENT" 2>/dev/null || true
exit: 0
stdout-contains: listening on 127.0.0.1:7736
stdout-contains: authorized clients 0
stdout-contains: no client is authorized yet
stdout-contains: maximum connections 8
stdout-contains: maximum connections per client 2
stdout-contains: maximum pending handshakes 1
stdout-contains: handshake timeout 500ms
stdout-contains: [{"key":"limits.remote_connections","value":8}]
stdout-contains: the peer over the pending-handshake ceiling was closed at once
stdout-contains: the silent peer was dropped when its handshake budget ran out
stdout-contains: event=connection.limit_denied
stdout-contains: error_code=remote.connection_limit
stdout-contains: is revoked; its next connection is refused and any session it holds is closed
stdout-contains: "code":"Ono-Sendai-E1202"
stdout-contains: "name":"remote.unauthorized"
stdout-not-contains: panicked
