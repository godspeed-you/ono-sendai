# v0.5 section 32.2 and section 49's "startup with temporal disabled". The v0.4 current-state
# budgets are re-measured in the container with the v0.5 tranche in the tree, because section 32.2
# is a promise about *not* regressing and a promise about not regressing is only kept by measuring
# again.
#
#   "v0.5 MUST NOT materially regress the v0.4 current-state targets:
#      interactive startup to usable prompt   < 150 ms target
#      basic look local cached                <  50 ms target
#      near cached                            <  50 ms target
#      map L0/L1 cached                       < 100 ms target"
#
# Three of the four rows say **cached**, and a cached figure is not a whole cold process: v0.4.1
# section 37.3 is explicit that "a warm-cache number MUST not be advertised as cold performance",
# and the same sentence read the other way forbids asserting a cold number against a cached
# budget. So a cached row is measured as a difference — the same process asked twice, minus the
# same process asked once — which is exactly the second answer's own cost and nothing else.
#
# Measured as a median over many runs, so one scheduling hiccup cannot fail the suite, and printed
# either way so a regression that stays inside the budget is still visible in a diff. The figures
# here are the container's; docs/contracts/hardening/performance_baseline.json holds the reference
# environment's under `spatial.look`, `spatial.map_first_frame` and `shell.cold_start`.
case: the v0.4 current-state budgets still hold with the v0.5 temporal tranche in the tree
timeout: 300
run: |
  runs=20

  # The median wall time of one whole `ono -c <script>` run, in milliseconds.
  each_ms() {
    local script="$1" start end
    ono --no-config -c "$script" >/dev/null 2>&1
    start=$(date +%s%N)
    for _ in $(seq $runs); do ono --no-config -c "$script" >/dev/null 2>&1; done
    end=$(date +%s%N)
    echo $(( (end - start) / 1000000 / runs ))
  }

  # A whole cold run against a budget: startup, provider, render and teardown together.
  measure() {
    local label="$1" limit_ms="$2" script="$3" each
    each=$(each_ms "$script")
    echo "$label: ${each}ms (target ${limit_ms}ms, ${runs} runs)"
    if [ "$each" -le "$limit_ms" ]; then echo "$label: within budget"; else echo "$label: OVER BUDGET"; fi
  }

  # A *cached* operation against a budget: the cost of asking a second time in a process that has
  # already asked once, which is what section 32.2's "cached" rows are about.
  measure_cached() {
    local label="$1" limit_ms="$2" once="$3" twice="$4" base full each
    base=$(each_ms "$once")
    full=$(each_ms "$twice")
    each=$(( full - base ))
    if [ "$each" -lt 0 ]; then each=0; fi
    echo "$label: ${each}ms cached (cold run ${base}ms, two-call run ${full}ms, target ${limit_ms}ms, ${runs} runs)"
    if [ "$each" -le "$limit_ms" ]; then echo "$label: within budget"; else echo "$label: OVER BUDGET"; fi
  }

  # Row 1: interactive startup to a usable prompt. The whole run of the cheapest statement there is.
  measure startup 150 'true'

  # Rows 2 and 3: a cached look and a cached near.
  measure_cached look 50 'look | count' 'look | count; look | count'
  measure_cached near 50 'near | count' 'near | count; near | count'

  # Row 4: the cached L0/L1 map frame.
  measure_cached map 100 'map | count' 'map | count; map | count'
exit: 0
stdout-contains: startup: within budget
stdout-contains: look: within budget
stdout-contains: near: within budget
stdout-contains: map: within budget
stdout-not-contains: OVER BUDGET
