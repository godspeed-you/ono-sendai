# v0.6.5 security review finding S-F5 in the container: a spatial word loads a lazy KUANG/11
# package only when the package's declaration on disk names the kind. K11P (a package is loaded on
# its first invocation, not on a typo), spec §31.68, v0.4 §6.5, §6.8, §11.2. ADR-1021.
#
# The package is the conformance fixture the container ships, first with a schema document naming
# its kind of place, then without one.
case: a kind word loads only the package that declares it on disk
timeout: 180
env: NO_COLOR=1
run: |
  prove() {
    local id="$1" what="$2" check="$3" out
    if out=$(eval "$check" 2>&1); then
      printf 'PROVED %s: %s\n' "$id" "$what"
    else
      printf 'FAILED %s: %s\n' "$id" "$what"
      printf '%s\n' "$out" | head -6 | sed 's/^/        /'
    fi
  }

  home=$(mktemp -d)
  export ONO_PLUGIN_PATH="$home/plugins"
  export XDG_STATE_HOME="$home/state"
  export XDG_CONFIG_HOME="$home/config"
  package="$home/plugins/dev.example.echo"
  mkdir -p "$package/runtime" "$package/contributions"
  cp /usr/local/bin/kuang-example-plugin "$package/runtime/echo"
  cat > "$package/manifest.yaml" <<'MANIFEST'
  format: kuang-package/1
  package:
    id: dev.example.echo
    name: echo
    version: 0.1.0
    description: Answers for a few resources.
    publisher: dev.example
    license: MIT
  compatibility:
    kuang_api: ">=11.1 <12"
    ono_language: ">=0.2"
    platforms: [linux-amd64, linux-arm64]
  runtime:
    kind: native-process
    entry: runtime/echo
    memory_max: 64MiB
    cpu_budget: interactive
    startup: lazy
  roles: [provider]
  contributions:
    targets: [contributions/targets.yaml]
    schemas: [contributions/schemas.yaml]
  network:
    outbound: none
  MANIFEST
  cat > "$package/contributions/targets.yaml" <<'TARGETS'
  targets:
    - name: echo-place
      schema: dev.example.echo.place/1
      summary: Resources the example package answers for.
      identity_doc: Two observations are the same resource when their `uid` matches.
      roles: [workload]
  TARGETS
  cat > "$package/contributions/schemas.yaml" <<'SCHEMAS'
  schemas:
    - id: dev.example.echo.place/1
      name: EchoPlace
  SCHEMAS

  loaded() { ono -c "$1; get plugin | where state == \"loaded\" | count | to text" 2>/dev/null | tail -1; }

  echo "== K11P: a word no declaration names loads nothing =="
  prove 171-a "\`jump typo/x\` starts no package" 'test "$(loaded "jump typo/x")" = "0"'
  prove 171-b "\`find place --type Typo\` starts no package" \
    'test "$(loaded "find place ledger --type Typo | count")" = "0"'
  prove 171-c "\`jump echoplace/ledger\` starts the package that declares the kind" \
    'test "$(loaded "jump echoplace/ledger")" = "1"'

  echo "== ADR-1021: without a schema document, the kind is reachable once the package is loaded =="
  rm "$package/contributions/schemas.yaml"
  sed -i '/schemas: \[contributions\/schemas.yaml\]/d' "$package/manifest.yaml"
  prove 171-d "\`jump echoplace/ledger\` does not start a package that declares no schema names" \
    'test "$(loaded "jump echoplace/ledger")" = "0"'
  prove 171-e "once loaded, the package's kind is reached by name" \
    'ono -c "load plugin dev.example.echo; jump echoplace/ledger; look --json" | tail -1 | grep -q "\"uid\":\"u-3\""'

  echo "kind word load checks done"
exit: 0
stdout-contains: PROVED 171-a
stdout-contains: PROVED 171-b
stdout-contains: PROVED 171-c
stdout-contains: PROVED 171-d
stdout-contains: PROVED 171-e
stdout-contains: kind word load checks done
stdout-not-contains: FAILED
stdout-not-contains: panicked
