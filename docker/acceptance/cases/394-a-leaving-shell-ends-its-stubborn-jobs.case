# Issue #303, through the real binary as an unprivileged user.
#
# A shell that leaves ends the jobs it owns (ADR-0959): `SIGTERM` to every job's programs at once,
# one shared grace period, then `SIGKILL` to what remains. Three jobs run a program that ignores
# `SIGTERM`; after the shell has exited none of them is left, which is polled with a bound. Each
# program announces that it runs by writing a file, and the shell waits for those files before it
# leaves; nothing below asserts a duration.
case: a leaving shell ends its jobs even when their programs ignore SIGTERM
timeout: 120
env: NO_COLOR=1
run: |
  printf '#!/bin/sh\ntrap "" TERM INT\nexec </dev/null >/dev/null 2>&1\n: > "$1"\nwhile :; do sleep 1; done\n' > "$HOME/case-394-stubborn.sh"
  chmod +x "$HOME/case-394-stubborn.sh"
  ono -c "fn stubborn(marker) { $HOME/case-394-stubborn.sh \$marker }
          stubborn $HOME/case-394.one &
          stubborn $HOME/case-394.two &
          stubborn $HOME/case-394.three &
          sh -c 'while [ ! -e $HOME/case-394.one ] || [ ! -e $HOME/case-394.two ] || [ ! -e $HOME/case-394.three ]; do sleep 0.05; done'
          echo all-started"
  echo "shell-exit-$?"
  # Counted by the programs' own command lines, which only they start with; `pgrep -f` would also
  # match the shell running this script, whose text names the program.
  left() { ps -eo pid=,args= | awk -v p="/bin/sh $HOME/case-394-stubborn.sh" 'index($0, p) && $2 == "/bin/sh" { print $1 }'; }
  tries=0
  while [ -n "$(left)" ] && [ "$tries" -lt 200 ]; do sleep 0.05; tries=$((tries + 1)); done
  echo "left-behind=$(left | wc -l)"
  for pid in $(left); do kill -KILL "$pid" || true; done
exit: 0
stdout-contains: all-started
stdout-contains: shell-exit-0
stdout-contains: left-behind=0
stdout-not-contains: panicked
